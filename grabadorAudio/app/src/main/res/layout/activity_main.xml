<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#122133"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="413dp"
        android:layout_height="0dp"
        android:layout_marginBottom="36dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView">

        <Button
            android:id="@+id/btn_grabar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#4BB388FF"
            android:onClick="Grabar"
            android:text="@string/btn_grabar"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_reproducir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#B3B388FF"
            android:onClick="reproducir"
            android:text="@string/btn_reproducir"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_detener"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2FEA80FC"
            android:onClick="Detener"
            android:text="@string/btn_detener"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/textView"
        android:layout_width="415dp"
        android:layout_height="68dp"
        android:layout_marginBottom="37dp"
        android:background="#EBEB37"
        android:text="@string/txt_titleAudio"
        android:textAlignment="center"
        android:textColor="#181313"
        android:textSize="24sp"
        android:textStyle="bold|italic"
        app:layout_constraintBottom_toTopOf="@+id/imageView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="230dp"
        android:layout_height="211dp"
        android:layout_marginBottom="46dp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView"
        app:srcCompat="@drawable/grabadora_icon" />

</androidx.constraintlayout.widget.ConstraintLayout>